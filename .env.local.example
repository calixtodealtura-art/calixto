# Firebase (cliente) — copiá estos valores desde tu consola Firebase
# https://console.firebase.google.com → Configuración del proyecto → Tus apps

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only) — usado para verificar el rol de admin y
# para las rutas API que escriben en Firestore sin pasar por las security rules.
# Generar en: Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada. Pegá el "private_key" del JSON tal cual, con
# los \n literales — el código ya los convierte a saltos de línea reales.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Mercado Pago
# https://www.mercadopago.com.ar/developers/panel → Tus integraciones
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Tu integración → Webhooks → Configurar notificaciones → "Clave secreta".
# Sin esto configurado, el webhook sigue funcionando pero no valida la firma
# de la notificación (queda un warning en los logs hasta que la configures).
MERCADOPAGO_WEBHOOK_SECRET=

# Cloudinary (subida de imágenes de producto, firmada server-side)
# https://console.cloudinary.com → Configuración → Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Dominio público del sitio (sin barra final) — usado en back_urls de Mercado
# Pago y como fallback de metadata.
NEXT_PUBLIC_APP_URL=https://calixto.ar
